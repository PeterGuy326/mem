# memd 环境变量 — 复制为 server/.env 并按需修改 (server/.env 已 gitignore)
#
# 裸机本地栈（无 Docker）：用 scripts/dev_up.sh 起 pg/minio/worker/memd，
# 这些默认值即为该脚本使用的配置。详见 docs/RUN_LOCAL.md。

# --- HTTP ---
# memd 监听地址 (host:port)
MEM_HTTP_ADDR=:8787

# --- PostgreSQL (with pgvector) ---
# 默认对齐 docker-compose 里的 mem-postgres (host:5432)
MEM_DB_URL=postgres://mem:mem@localhost:5432/mem?sslmode=disable

# --- Redis (asynq queue) ---
# 裸机栈不起 Redis：留空触发 memd 的进程内 goroutine fallback（见 cmd/memd/main.go）。
# 上传仍走异步索引，只是不具备崩溃恢复（dev 足够）。生产环境必须设真实 Redis。
MEM_REDIS_URL=

# --- S3 / MinIO ---
# 注意: compose 把 host port 从 9000 平移到 9100，避免和其他本地 MinIO 撞端口
MEM_S3_ENDPOINT=http://localhost:9100
MEM_S3_BUCKET=mem
MEM_S3_ACCESS_KEY=mem
MEM_S3_SECRET_KEY=mem-minio-password
MEM_S3_REGION=us-east-1
# MEM_S3_USE_SSL=false   # 默认根据 endpoint 的 https:// 前缀推断

# --- Worker (Python AI gRPC) ---
# 本机跑 `make worker` 时默认监听 localhost:50051
MEM_WORKER_GRPC=localhost:50051

# --- Deployment / Auth ---
# private: 私有部署基础模式；saas: 多租户托管模式（本阶段能力相同，供 capabilities/部署策略识别）
MEM_DEPLOYMENT_MODE=private
# open: 任意注册；first_user: 仅允许首个用户；disabled: 完全关闭注册
MEM_REGISTRATION_MODE=open
# 登录后签发的 session token 有效期 (Go duration: 24h, 7d, 30m...)
MEM_SESSION_TTL=24h
# 前后端分离部署时的浏览器跨域白名单（逗号分隔 origin，如 https://app.example.com）。
# 留空 = 不下发 CORS 头，仅支持同源/代理访问（本地 vite dev proxy 即此模式）。
MEM_CORS_ORIGINS=

# --- Workspace Transfer ---
# 单次 workspace 导入/导出的总超时（普通 HTTP 请求仍保持 60s）
MEM_WORKSPACE_TRANSFER_TIMEOUT=30m
# 导入请求和导出归档共用的硬上限，单位为字节（默认 8 GiB）
MEM_WORKSPACE_BUNDLE_MAX_BYTES=8589934592
# 单个 memd 实例同时执行的导入/导出数；超出时返回 429 + Retry-After
MEM_WORKSPACE_TRANSFER_MAX_CONCURRENT=2
# 可选：归档临时文件目录。memd 会创建缺失目录，但要求最终权限恰好为 0700。
# 生产环境建议放在容量受控的专用卷中；不要与其他应用共享。
# MEM_WORKSPACE_TRANSFER_TMP_DIR=/var/lib/mem/workspace-transfer

# --- Dev ---
# debug|info|warn|error
MEM_LOG_LEVEL=info
