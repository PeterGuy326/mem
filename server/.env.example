# memd 环境变量 — 复制为 server/.env 并按需修改 (server/.env 已 gitignore)
#
# 裸机本地栈（无 Docker）：用 scripts/dev_up.sh 起 pg/minio/worker/memd，
# 这些默认值即为该脚本使用的配置。详见 docs/RUN_LOCAL.md。

# --- HTTP ---
# memd 监听地址 (host:port)
MEM_HTTP_ADDR=:8787

# --- PostgreSQL (with pgvector) ---
# 默认对齐 docker-compose 里的 mem-postgres (host:5432)
MEM_DB_URL=postgres://mem:mem@localhost:5432/mem?sslmode=disable

# --- Redis (asynq queue) ---
# 裸机栈不起 Redis：留空触发 memd 的进程内 goroutine fallback（见 cmd/memd/main.go）。
# 上传仍走异步索引，只是不具备崩溃恢复（dev 足够）。生产环境必须设真实 Redis。
MEM_REDIS_URL=

# --- S3 / MinIO ---
# 注意: compose 把 host port 从 9000 平移到 9100，避免和其他本地 MinIO 撞端口
MEM_S3_ENDPOINT=http://localhost:9100
MEM_S3_BUCKET=mem
MEM_S3_ACCESS_KEY=mem
MEM_S3_SECRET_KEY=mem-minio-password
MEM_S3_REGION=us-east-1
# MEM_S3_USE_SSL=false   # 默认根据 endpoint 的 https:// 前缀推断

# --- Worker (Python AI gRPC) ---
# 本机跑 `make worker` 时默认监听 localhost:50051
MEM_WORKER_GRPC=localhost:50051

# --- Auth ---
# 登录后签发的 session token 有效期 (Go duration: 24h, 7d, 30m...)
# MEM_SESSION_TTL=24h

# --- Dev ---
# debug|info|warn|error
MEM_LOG_LEVEL=info
