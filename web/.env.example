# When true, MSW intercepts /v1/* in the browser (mock data, no backend needed).
# When false, the vite dev server proxies /v1/* to the real Go backend (memd)
# at http://localhost:8787 (see vite.config.ts proxy). For local dev against
# the bare-metal stack (scripts/dev_up.sh), set this to false.
VITE_USE_MOCK=false
