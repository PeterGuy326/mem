server/coverage.html
server/*.test
server/.air.toml

# === Python (worker/) ===
worker/__pycache__/
worker/**/__pycache__/
worker/*.pyc
worker/.venv/
worker/venv/
worker/dist/
worker/build/
worker/*.egg-info/
worker/.pytest_cache/
worker/.ruff_cache/
worker/.mypy_cache/

# === Node / Web (web/) ===
web/node_modules/
web/dist/
web/build/
web/.next/
web/out/
web/coverage/
web/.turbo/

# === Generated proto ===
**/*_pb2.py
**/*_pb2_grpc.py
**/*.pb.go
server/internal/workerpb/*.pb.go
worker/mem_worker/proto/*_pb2.py
worker/mem_worker/proto/*_pb2_grpc.py
worker/mem_worker/proto/*_pb2.pyi

# === Local data / scratch ===
# Root-anchored so we don't accidentally swallow Go packages named "storage".
/data/
/storage/
.scratch/
*.log

# === Bare-metal dev stack (scripts/dev_up.sh) ===
# Local runtime: postgres cluster, minio data, downloaded binaries, logs, pids.
/.dev/

# === Docker ===
.docker-data/

# === Misc ===
node_modules/
*.tsbuildinfo

# === Agent worktrees (Claude Code worktree isolation) ===
.claude/

