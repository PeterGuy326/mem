# mem AI Worker 环境变量 — 复制为 worker/.env 并按需修改 (worker/.env 已 gitignore)
# 裸机本地栈默认值（无 Docker）：scripts/dev_up.sh 会用这些值起 worker。

# --- gRPC server ---
# worker 监听地址（memd 通过 MEM_WORKER_GRPC=localhost:50051 连接）
MEM_WORKER_GRPC_HOST=127.0.0.1
MEM_WORKER_GRPC_PORT=50051
MEM_WORKER_GRPC_MAX_WORKERS=8
# 本地默认 private；托管部署必须显式设为 saas，并开启下面的 request auth。
MEM_DEPLOYMENT_MODE=private

# --- Object storage (S3 / MinIO) ---
# worker 从对象存储拉文件字节做处理；与 server/.env 保持一致
MEM_S3_ENDPOINT=http://localhost:9100
MEM_S3_REGION=us-east-1
MEM_S3_BUCKET=mem
MEM_S3_ACCESS_KEY=mem
MEM_S3_SECRET_KEY=mem-minio-password
MEM_S3_USE_SSL=false

# --- Provider: Ollama (本地默认) ---
# SaaS 必须保持为无 credentials/query/fragment 的 localhost 或 loopback IP URL。
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=300

# --- Provider: OpenAI-compatible（按需启用；不要把真实 key 提交到此文件）---
# OPENAI_BASE_URL=https://your-compatible-gateway.example
# OPENAI_API_KEY=replace-with-a-local-secret
# 仅托管 V1 兼容 binding 设置；会要求 Worker auth、完整 HTTPS endpoint/key，
# 并关闭跨 origin HTTP redirect。开启后任何 deployment 的整个 openai:*
# namespace 仅允许已认证 AI profile 使用；普通 private BYOM 必须保持 false。
# MEM_OPENAI_MANAGED_BINDING=true
# 仅在默认 embedding 端点支持 OpenAI `dimensions` 参数时设置。workspace
# 质量档会自行按请求传入 text-embedding-3-large 的 768 维，且不读取此默认值。
# OPENAI_EMBEDDING_DIMENSIONS=768

# --- Provider: Idealab managed binding（仅 SaaS 质量档；不要复用 OPENAI_*）---
# IDEALAB_BASE_URL=https://<idealab-openai-compatible-endpoint>
# IDEALAB_API_KEY=replace-with-a-runtime-secret

# --- memd -> Worker request/response authentication (required for SaaS) ---
# Generate exactly 32 random bytes and store their standard-base64 encoding in
# both memd and Worker secret stores. All Worker replicas share one Redis.
# MEM_WORKER_AUTH_MODE=required
# MEM_WORKER_AUTH_KEY_ID=memd-primary
# MEM_WORKER_AUTH_KEY_B64=replace-with-standard-base64
# MEM_WORKER_AUTH_REPLAY_REDIS_URL=rediss://user:password@redis.internal:6379/0

# --- 默认 provider 规格 (SPEC §9.4) ---
# SaaS 下每个非空 MEM_DEFAULT_* 都必须使用本地 vendor（ollama、clip、
# faster-whisper 或 whisper）；空值仍可表示关闭对应 stage。否则 Worker 拒绝
# 启动。legacy/no-profile 请求的任意远程 provider override 会在拉取文件或
# 构造 provider 前被拒绝。
# 文本 embedding: nomic-embed-text = 768 维，正好对上 embeddings_text vector(768)
MEM_DEFAULT_EMBEDDING=ollama:nomic-embed-text
# 文本/PDF/音频的索引增强：生成待人工确认的描述和标签；不可用时索引降级但不失败
MEM_DEFAULT_LLM=ollama:qwen2.5:7b
# 视觉 embedding: 保持 clip:ViT-B-32 (512 维)。本机未装 open_clip / 无 minicpm-v，
# 图片走优雅降级——不产出 visual 向量，只存 caption/EXIF 元数据，索引不崩。
# 即便误配成 768 维的文本 embedder，image.py 也会按维度 (512) 守卫跳过，不会崩。
MEM_DEFAULT_VISUAL_EMBEDDING=clip:ViT-B-32
# VLM: 本机无 minicpm-v；保留默认值，caption 路径会优雅降级（warning 不崩）
MEM_DEFAULT_VLM=ollama:minicpm-v
# ASR: 本地 faster-whisper；SaaS 不允许改为远程 vendor
MEM_DEFAULT_ASR=faster-whisper:tiny

# --- Pipeline knobs ---
MEM_TEXT_CHUNK_SIZE=1000
MEM_TEXT_CHUNK_OVERLAP=100

# --- Logging ---
MEM_LOG_LEVEL=INFO
MEM_LOG_JSON=false
