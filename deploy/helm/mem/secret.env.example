# Copy to a protected file outside the repository, replace every value, then:
# kubectl -n mem-system create secret generic mem-runtime \
#   --from-env-file=/secure/path/mem-runtime.env
#
# Percent-encode reserved characters in URL usernames and passwords.
MEM_DB_URL=postgres://mem:replace-me@postgres.example.internal:5432/mem?sslmode=verify-full
MEM_REDIS_URL=rediss://:replace-me@redis.example.internal:6379/0
MEM_WORKER_AUTH_REPLAY_REDIS_URL=rediss://:replace-me@redis.example.internal:6379/1
MEM_S3_ENDPOINT=https://s3.example.internal
MEM_S3_REGION=us-east-1
MEM_S3_BUCKET=mem
MEM_S3_ACCESS_KEY=replace-me
MEM_S3_SECRET_KEY=replace-me
MEM_S3_USE_SSL=true
MEM_WORKER_AUTH_KEY_ID=memd-primary
MEM_WORKER_AUTH_KEY_B64=replace-with-standard-base64-for-exactly-32-random-bytes
