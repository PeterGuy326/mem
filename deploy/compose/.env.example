# Copy this file to .env with ./generate-env.sh; do not commit the generated file.
MEM_IMAGE_TAG=local
MEM_BIND_ADDRESS=127.0.0.1
MEM_EDGE_PORT=8080
MEM_MAX_BODY_SIZE=256m
MEM_REGISTRATION_MODE=first_user
MEM_LOG_LEVEL=info
MEM_WORKER_GRPC_MAX_WORKERS=8
MEM_WORKER_EXTRAS=
MEM_S3_BUCKET=mem

# Required secrets. generate-env.sh fills these with URL-safe/random values.
MEM_POSTGRES_PASSWORD=
MEM_REDIS_PASSWORD=
MEM_S3_ACCESS_KEY=
MEM_S3_SECRET_KEY=
MEM_WORKER_AUTH_KEY_ID=memd-primary
MEM_WORKER_AUTH_KEY_B64=

# Optional prebuilt images. Leave unset to build from this checkout.
# MEM_SERVER_IMAGE=ghcr.io/example/mem-server:replace-with-version
# MEM_WORKER_IMAGE=ghcr.io/example/mem-worker:replace-with-version
# MEM_WEB_IMAGE=ghcr.io/example/mem-web:replace-with-version
